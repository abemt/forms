# ============================================================
# Form 680 AutoNotes - configuration
# Copy this file to .env and fill in your values.
#
# ZERO-COST MODE: no .env is required at all. Without one, the
# app runs the built-in rule engine — fully offline, no AI, $0.
# ============================================================

# --- Engine ---
# local = built-in rule engine (offline, free, the default when no AI key set)
# ai    = OpenAI-compatible provider (requires AI_API_KEY)
# auto  = ai when configured, otherwise local
ENGINE=auto

# --- AI provider (optional, OpenAI-compatible chat completions API) ---
# Only needed for ENGINE=ai. Works with OpenAI, Azure OpenAI (compatible
# endpoint), OpenRouter, Groq, Together, or a local Ollama / LM Studio server.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Number of shifts analyzed by the AI in parallel
AI_CONCURRENCY=4
# Retries per AI call on transient failures (429/5xx/network)
AI_MAX_RETRIES=3
# Timeout per AI request, in milliseconds
AI_TIMEOUT_MS=120000

# --- Server ---
PORT=8787
# Where uploads, caches and generated output are stored
DATA_DIR=./data
# Max upload size per file, in megabytes
MAX_UPLOAD_MB=50
# Number of PDFs generated in parallel
PDF_CONCURRENCY=6
# Jobs older than this many hours are deleted on startup (0 disables cleanup)
JOB_TTL_HOURS=0

# Path to the built frontend (served statically in production).
# Leave as-is when using `npm run build` / Docker.
WEB_DIST=../web/dist
